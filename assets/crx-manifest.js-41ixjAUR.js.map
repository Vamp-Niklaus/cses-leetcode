export default "{\"manifest_version\":3,\"name\":\"Leetify for CSES\",\"description\":\"A modern, Leetcode-style workspace for solving CSES problems.\",\"version\":\"1.1.1\",\"icons\":{\"16\":\"icons/icon-16.png\",\"32\":\"icons/icon-32.png\",\"48\":\"icons/icon-48.png\",\"128\":\"icons/icon-128.png\"},\"action\":{\"default_popup\":\"src/app/popup/index.html\",\"default_icon\":{\"16\":\"icons/icon-16.png\",\"32\":\"icons/icon-32.png\",\"48\":\"icons/icon-48.png\",\"128\":\"icons/icon-128.png\"}},\"background\":{\"service_worker\":\"src/extension/background/index.ts\",\"type\":\"module\"},\"content_scripts\":[{\"matches\":[\"https://cses.fi/*\"],\"js\":[\"src/extension/content/index.tsx\"],\"run_at\":\"document_idle\"}],\"permissions\":[\"storage\",\"activeTab\"],\"host_permissions\":[\"https://cses.fi/*\",\"https://leetify-cses-judge-proxy.navoren.workers.dev/*\"],\"web_accessible_resources\":[{\"resources\":[\"assets/*\"],\"matches\":[\"https://cses.fi/*\"]}]}"